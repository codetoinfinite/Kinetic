{
  "name": "kinetic",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Motion components for React: live previews, complete source, and a prompt written for coding agents.",
  "license": "MIT",
  "author": "Ordis AI",
  "homepage": "",
  "repository": "https://github.com/codetoinfinite/Kinetic",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-8927}",
    "build": "pnpm registry:build && next build",
    "start": "next start --port ${PORT:-8927}",
    "registry:build": "tsx scripts/build-registry.ts",
    "status": "tsx scripts/status.ts",
    "check:licenses": "tsx scripts/check-licenses.ts",
    "check:prompts": "tsx scripts/check-prompts.ts",
    "check:classes": "tsx scripts/check-classes.ts",
    "smoke": "playwright test",
    "verify": "tsc --noEmit && pnpm registry:build && next build && pnpm check:licenses && pnpm check:prompts && pnpm check:classes && pnpm smoke"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.11",
    "lottie-web": "^5.13.0",
    "matter-js": "^0.20.0",
    "next": "16.2.12",
    "ogl": "^1.0.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shiki": "^3.14.0",
    "split-type": "^0.3.4",
    "tailwind-merge": "^3.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/matter-js": "^0.20.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@types/three": "^0.185.0",
    "marked": "^15.0.12",
    "shadcn": "4.16.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "zod": "^4.1.12"
  }
}
